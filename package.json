{
  "name": "phototagger",
  "version": "1.0.0",
  "description": "Portable hierarchical photo organizer",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\""
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.12",
    "better-sqlite3": "13.0.3",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "yazl": "3.3.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.11",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/yazl": "3.3.1",
    "css-loader": "6.10.0",
    "electron": "44.3.0",
    "eslint": "10.10.0",
    "fork-ts-checker-webpack-plugin": "9.0.2",
    "html-webpack-plugin": "5.6.0",
    "mini-css-extract-plugin": "2.9.4",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "style-loader": "3.3.4",
    "ts-loader": "9.5.1",
    "tsx": "4.19.2",
    "typescript": "5.4.5",
    "vitest": "5.0.0",
    "webpack": "5.110.3"
  },
  "private": true,
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  }
}
